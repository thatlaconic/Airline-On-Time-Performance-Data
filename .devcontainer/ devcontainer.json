{
  "name": "dbt BigQuery",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dbt-bq",
  "workspaceFolder": "/workspaces",
  "remoteEnv": {
    "GOOGLE_APPLICATION_CREDENTIALS": "/workspaces/.gcp/credentials.json",
    "DBT_PROFILES_DIR": "/workspaces/.dbt"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "innoverio.vscode-dbt-power-user"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}