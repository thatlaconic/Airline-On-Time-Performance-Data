FROM ghcr.io/dbt-labs/dbt-bigquery:latest

# Set default workspace path (Codespaces uses /workspaces/repo-name)
ENV WORKSPACE_DIR=/workspaces/DE-project

# Create workspace directory and set permissions
RUN mkdir -p ${WORKSPACE_DIR} && \
    chown -R vscode:vscode ${WORKSPACE_DIR}

# Install additional tools
RUN apt-get update && \
    apt-get install -y git bash-completion && \
    rm -rf /var/lib/apt/lists/*

# Switch to non-root user
USER vscode
WORKDIR ${WORKSPACE_DIR}

# Pre-install common packages
COPY requirements.txt .
RUN pip install --user -r requirements.txt